<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's themed (monochrome) layer, used when the user turns on
  themed icons: the system throws the colours away and tints the alpha channel,
  so this is a silhouette and nothing else.

  That is why it is a separate file from the foreground rather than the same
  drawable used twice, which is what it was before the artwork arrived. A
  knocked-out shape has to be a hole in the path; filled with the background
  colour it looks right in colour and disappears entirely once tinted, which
  is what happened to the old play mark.

  A film strip rather than the guru: the full artwork is modelled shading, and
  a silhouette of it is a blob. 108dp canvas, mark inside the middle 72dp,
  which is the adaptive icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      One path, even-odd: the strip, then the perforations and the play mark
      drawn inside it, each of which toggles back to empty and so becomes a
      real hole rather than a lighter patch.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M21,36h66a3,3 0,0 1,3 3v30a3,3 0,0 1,-3 3h-66a3,3 0,0 1,-3 -3v-30a3,3 0,0 1,3 -3z
                          M21,39h6v6h-6z M33,39h6v6h-6z M45,39h6v6h-6z M57,39h6v6h-6z M69,39h6v6h-6z M81,39h6v6h-6z
                          M21,63h6v6h-6z M33,63h6v6h-6z M45,63h6v6h-6z M57,63h6v6h-6z M69,63h6v6h-6z M81,63h6v6h-6z
                          M48,45.5L65,54L48,62.5z" />
</vector>
