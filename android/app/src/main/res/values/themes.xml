<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this exists so the window has sane
         colours before the first frame and the splash does not flash white
         in dark mode. -->
    <style name="Theme.WatchGuru" parent="android:Theme.Material.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
