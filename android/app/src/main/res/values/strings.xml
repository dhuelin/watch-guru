    <!-- Shown when changes made offline have not reached the server yet. Not
         an error: nothing has gone wrong, and they will be sent. -->
    <plurals name="pending_changes">
        <item quantity="one">%1$d change waiting to sync</item>
        <item quantity="other">%1$d changes waiting to sync</item>
    </plurals>

    <!-- Content descriptions. These say what a control does, not what it is:
         "button" tells a TalkBack user nothing about which episode it marks. -->
    <string name="cd_mark_episode_watched">Mark %1$s watched</string>
    <string name="cd_mark_episode_unwatched">Mark %1$s unwatched</string>
    <string name="cd_poster">Poster for %1$s</string>
    <string name="cd_progress">%1$d of %2$d episodes watched</string>
