    <string name="where_to_watch_updated">Checked %1$s</string>
    <string name="justwatch_attribution">Streaming availability data provided by JustWatch.</string>

    <!-- Stats. The streak rule is stated in the UI rather than left to be
         inferred, because an arbitrary-feeling streak is worse than none. -->
    <string name="title_stats">Statistics</string>
    <string name="action_view_stats">Statistics</string>
    <string name="empty_stats">Nothing watched yet. Mark something watched and this fills in.</string>
