    <string name="action_cancel">Cancel</string>
    <string name="delete_account_title">Delete your account?</string>
    <string name="delete_account_message">This removes your library, progress and history permanently. It cannot be undone.</string>
    <string name="delete_account_footer">Deleting your account removes your library, progress and history permanently.</string>

    <!-- Region. Not cosmetic: it decides which streaming offers are shown,
         and every account starts on a default that is wrong for most people. -->
    <string name="region_label">Region</string>
    <string name="region_picker_title">Choose your region</string>
    <string name="region_search_hint">Search countries</string>
    <string name="region_explainer">Streaming offers are shown for this country.</string>
    <string name="error_region_update">Couldn\'t change your region. Please try again.</string>

    <!-- Where to watch. The provider gives one link per region listing every
         way to watch a title, not a deep link per service, so the section
         offers a single link rather than pretending each row opens that app. -->
    <string name="where_to_watch">Where to watch</string>
    <string name="offer_flatrate">Stream</string>
    <string name="offer_free">Free</string>
    <string name="offer_ads">Free with ads</string>
