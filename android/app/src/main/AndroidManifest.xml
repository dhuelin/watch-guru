<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      New-episode notifications (#19). Declared from Android 13, where posting
      a notification needs the user's say-so; below it the permission does not
      exist and installing the app is the consent.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off: everything the app keeps is either the session, which
      must not leave the device, or a cache of what the server already holds.
      A restored copy of the encrypted session cannot even be read: the
      Keystore key it was sealed with is never backed up.

      icon and roundIcon point at the same adaptive icon. The round variant
      existed and was referenced by nothing, so a launcher that asks for one
      got no answer and masked the square icon itself.
    -->
    <application
        android:name=".WatchGuruApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchGuru">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WatchGuru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where the browser lands after Trakt. Exported and BROWSABLE because a
          browser has to be able to open it; it trusts nothing it is given,
          only passing the code and state on to be finished under this app's
          session. No screen of its own, so it is translucent and leaves no
          trace in Recents.
        -->
        <activity
            android:name=".TraktCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="watchguru"
                    android:host="trakt"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!--
          The home-screen widget. exported="true" is required: the launcher is
          another app and has to be able to bind it.
        -->
        <receiver
            android:name=".widget.UpNextWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_widget_info" />
        </receiver>
    </application>
</manifest>
