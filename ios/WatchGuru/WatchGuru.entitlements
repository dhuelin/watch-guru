<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sign in with Apple. The capability must also be enabled on the App ID in
	  the developer portal; this file alone is not enough, and without the
	  portal side ASAuthorizationController fails at runtime rather than at
	  build time.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  Shared with the widget extension, which is a separate process and would
	  otherwise see none of this app's files. Everything the offline layer
	  writes lives in this container now; see FileOfflineStore.
	-->
	<!--
	  New-episode notifications (#19). "development" is the sandbox APNs
	  environment; a release build needs "production", which the distribution
	  profile supplies at signing time rather than this file.

	  Like Sign in with Apple, the capability must also be enabled on the App ID
	  in the developer portal (#30). Without the portal side,
	  registerForRemoteNotifications fails at runtime with no build error, which
	  is why PushTokens records the reason and the settings screen shows it
	  rather than leaving a switch that silently does nothing.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.dhuelin.watchguru</string>
	</array>
	<!--
	  So the widget can read the session this app saved.

	  Adding this moves where new Keychain items go: an item saved with no
	  explicit access group lands in the first group listed here rather than in
	  the app's default one. An install that predates this entitlement therefore
	  has a session the app can no longer see, and asks the user to sign in once.
	  Nobody has run this app yet, so that costs nothing today; it would need a
	  migration if it were already shipping.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.dhuelin.watchguru</string>
	</array>
</dict>
</plist>
